{
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  // Configuración de ESLint para corregir errores automáticamente al guardar
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "editor.quickSuggestions": {
    "comments": true
  },
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "eslint.codeAction.disableRuleComment": {
    "enable": true,
    "location": "sameLine"
  },
  "eslint.options": {
    "rulePaths": []
  },
  "eslint.lintTask.enable": true,
  "editor.codeActionsOnSave.mode": "all"
}
