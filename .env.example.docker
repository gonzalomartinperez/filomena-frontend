# Public, non-secret defaults for the frontend container.
APP_URL=http://localhost
ENVIRONMENT=production
PORT=3000
HOSTNAME=0.0.0.0

# Local backend exposed by the companion backend repository.
BACKEND_PORT=8000
BACKEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Filomena

# Docker Compose / BuildKit configuration.
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_BAKE=true
COMPOSE_PROJECT_NAME=filomena-frontend
